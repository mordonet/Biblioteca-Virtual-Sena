@{
    ViewData["Title"] = "Inicio";
}

<div class="hero">
    <h1>Bienvenido a tu Biblioteca Virtual</h1>
    <p>Descubre un mundo de conocimiento al alcance de tu mano. Miles de libros disponibles para explorar, aprender y disfrutar.</p>
    <a asp-controller="Book" asp-action="Catalog" class="btn btn-primary">Explorar Catálogo</a>
</div>

<div class="features">
    <div class="feature-card">
        <div class="feature-icon">🔍</div>
        <h3>Búsqueda Avanzada</h3>
        <p>Encuentra fácilmente los libros que necesitas con nuestro sistema de búsqueda inteligente.</p>
    </div>
    <div class="feature-card">
        <div class="feature-icon">📱</div>
        <h3>Acceso Multiplataforma</h3>
        <p>Disfruta de tus libros favoritos en cualquier dispositivo, en cualquier momento.</p>
    </div>
    <div class="feature-card">
        <div class="feature-icon">⭐</div>
        <h3>Favoritos Personalizados</h3>
        <p>Guarda tus libros preferidos para acceder a ellos rápidamente después.</p>
    </div>
</div>