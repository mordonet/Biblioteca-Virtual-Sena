@model IEnumerable<BibliotecaVirtual.Models.Favorito>
@{
    ViewData["Title"] = "Mis Favoritos";
}

<h2>Mis Libros Favoritos</h2>
<hr />

@if (Model.Any())
{
    <div class="books-grid">
        @foreach (var favorito in Model)
        {
            <div class="book-card">
                <div class="book-cover">
                    <img src="@favorito.Libro.UrlPortada" alt="Portada de @favorito.Libro.Titulo">
                </div>
                <div class="book-info">
                    <h3 class="book-title">@favorito.Libro.Titulo</h3>
                    <p class="book-author">@favorito.Libro.Autor</p>
                    <div class="book-actions">
                        <a asp-controller="Book" asp-action="Details" asp-route-id="@favorito.Libro.Id" class="btn btn-primary action-btn">Ver Más</a>

                        <form asp-controller="Favorites" asp-action="Remove" method="post" style="display: inline;">
                            <input type="hidden" name="libroId" value="@favorito.Libro.Id" />
                            <button type="submit" class="btn btn-danger btn-sm action-btn">Quitar</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p>Aún no has agregado ningún libro a tus favoritos. ¡Explora el catálogo!</p>
}